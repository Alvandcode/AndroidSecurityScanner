<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud/local backup: scan history contains installed-package list (sensitive). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="datastore" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="datastore" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
